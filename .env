# MCF (Multichannel Communication Framework) Environment Variables

# === Logic Service (Go) ===
# HTTP Gateway Configuration
HTTP_LISTEN_ADDR=0.0.0.0:8080

# RTP Gateway Configuration  
RTP_LISTEN_ADDR=0.0.0.0:5004

# AI Service gRPC Client Configuration
AI_SERVICE_ADDRESS=127.0.0.1:50052

# Session Configuration
SESSION_ID=CALL-TEST-001

# Logging
LOG_LEVEL=info

# === AI Engine Service (Python) ===
# gRPC Server Configuration
GRPC_SERVER_ADDRESS=0.0.0.0:50052
GRPC_MAX_WORKERS=4

# Model Configuration
DEVICE=cuda
WHISPER_MODEL_SIZE=small
COMPUTE_TYPE=int8

# Audio Processing Configuration
SAMPLE_RATE=16000
SILENCE_THRESHOLD=0.012
SILENCE_TIMEOUT_SECONDS=0.6
MAX_AUDIO_SECONDS=15.0
MIN_AUDIO_SECONDS=1.0

# VAD (Voice Activity Detection) Configuration
VAD_THRESHOLD=0.5
