# MCF (Multichannel Communication Framework) Environment Variables

# === Logic Service (Go) ===
# HTTP Gateway Configuration
HTTP_LISTEN_ADDR=0.0.0.0:8080

# RTP Gateway Configuration  
RTP_LISTEN_ADDR=0.0.0.0:5004

# AI Service gRPC Client Configuration
AI_SERVICE_ADDRESS=127.0.0.1:50052

# Session Configuration
SESSION_ID=CALL-TEST-001

# Logging
LOG_LEVEL=info

# === AI Engine Service (Python) ===
# gRPC Server Configuration
GRPC_SERVER_ADDRESS=0.0.0.0:50052
GRPC_MAX_WORKERS=4

# Model Configuration
DEVICE=cuda
WHISPER_MODEL_SIZE=small
COMPUTE_TYPE=int8

# Audio Processing Configuration
SAMPLE_RATE=16000
SILENCE_THRESHOLD=0.012
SILENCE_TIMEOUT_SECONDS=0.6
MAX_AUDIO_SECONDS=15.0
MIN_AUDIO_SECONDS=1.0

# VAD (Voice Activity Detection) Configuration
VAD_THRESHOLD=0.5

# Video models
SEG_MODEL_PATH="../model_checkpoints/selfie_segmenter.tflite"
INFER_FPS=10
INFER_WIDTH=256
INFER_HEIGHT=144
VIDEO_EFFECT='bg_replace'
BG_IMAGE_PATH='model_checkpoints/bg_image.jpg'
# === v3.1: MF <-> RTPGW gRPC video ingest, LIVE_STREAM, AI -> MF HTTP push ===
# See rtpgw_design_v3.md section 35 for rationale.

# RTPGW (Go): new gRPC server MF connects to (video_ingest.proto)
VIDEO_INGEST_LISTEN_ADDR=0.0.0.0:50060
# v3.2: fallback only, used if a client's RtpOpen doesn't carry
# decode_width/decode_height (see rtpgw_design_v3.md section 37.5). New MF
# clients always send it, sourced from their own --width/--height.
VIDEO_FRAME_WIDTH=240
VIDEO_FRAME_HEIGHT=320
VIDEO_FFMPEG_BINARY=ffmpeg
VIDEO_JPEG_QUALITY=80

# AI Engine (Python): MediaPipe running mode + where to push mask results
VIDEO_RUNNING_MODE=LIVE_STREAM
MF_CALLBACK_URL=http://127.0.0.1:8090/v1/video/mask
MF_CALLBACK_TIMEOUT_MS=800
# Legacy synchronous IMAGE-mode HTTP endpoint (disabled by default in v3.1)
VIDEO_HTTP_ENABLED=false

# MF (C++, mf_cpp): see mf_cpp/README.md for the matching CLI flags
# --rtpgw-grpc-addr 127.0.0.1:50060
# --mask-callback-listen-addr 0.0.0.0 --mask-callback-listen-port 8090
# --mf-callback-url http://127.0.0.1:8090/v1/video/mask
